set pagination off
set startup-with-shell off
set debuginfod enabled off
set confirm off
set $vfs495_raw_provisioned = 0
set $vfs495_initial_cache_valid = 0
set $vfs495_setowner_result_ptr = 0

# The VFS495 reports the defined provisioned state (0x2), but this release's
# post-patch version path overwrites the correctly derived cache value with
# zero.  The synchronous WithKeys API consults that cache and otherwise returns
# VCS_RESULT_SENSOR_CMD_DENIED before it submits any request.  Preserve the
# raw-derived value under the same product/state guards as the standard
# SetOwner compatibility mode.
break *0x5177e0
commands 1
  silent
  set $vfs495_raw_state = *(unsigned char *) ($rsp + 0x145)
  set $vfs495_product_id = *(unsigned short *) ($rsp + 0x140)
  printf "AES ownership raw state/product: 0x%x/0x%x\n", $vfs495_raw_state, $vfs495_product_id
  if $vfs495_raw_state != 2 || $vfs495_product_id != 0x3f
    printf "AES ownership guard: unexpected raw device state; aborting.\n"
    kill
    quit 4
  end
  set $vfs495_raw_provisioned = 1
  continue
end

break *0x5178b0
commands 2
  silent
  if $vfs495_raw_provisioned != 1 || $edx != 1
    printf "AES ownership guard: initial cache derivation mismatch; aborting.\n"
    kill
    quit 4
  end
  set $vfs495_initial_cache_valid = 1
  continue
end

break *0x50ae5a
commands 3
  silent
  if $vfs495_raw_provisioned != 1 || $vfs495_initial_cache_valid != 1
    printf "AES ownership guard: missing raw provisioning evidence; aborting.\n"
    kill
    quit 4
  end
  printf "Preserving raw isProvisioned=1 over post-patch derived value %u.\n", $eax
  set $eax = 1
  continue
end

# Main accepts only the public `setowner -doinit` command. Immediately before
# dispatch, require its exact processed shape and replace only the handler with
# the vendor's hidden setowner_with_keys implementation. Reuse argv[0]'s long,
# writable process-argument buffer for the two short option strings; no new
# process memory or untracked key data is introduced by the debugger.
break *0x4404a2
commands 4
  silent
  if $ebp != 2 || $edi != 2
    printf "AES-key ownership guard: unexpected processed argc %d/%d; aborting.\n", $ebp, $edi
    kill
    quit 4
  end
  if *(void **) ($rbx + 8) != SensorSetOwner
    printf "AES-key ownership guard: original handler mismatch; aborting.\n"
    kill
    quit 4
  end
  set $vfs495_args = $r15
  set $vfs495_scratch = *((char **) $vfs495_args)
  set {char[4]} $vfs495_scratch = "cik"
  set {char[5]} ($vfs495_scratch + 4) = "cios"
  set *((char **) $vfs495_args + 1) = $vfs495_scratch
  set *((char **) $vfs495_args + 2) = $vfs495_scratch + 4
  set *(void **) ($rbx + 8) = SensorSetOwnerWithKeys
  set $edi = 3
  printf "AES-key ownership guard passed; dispatching CIK/CIOS ownership.\n"
  continue
end

break SensorSetOwnerWithKeys
commands 5
  silent
  printf "Entered SensorSetOwnerWithKeys with options %s and %s.\n", *((char **) $rsi + 1), *((char **) $rsi + 2)
  continue
end

break *0x44b925
commands 6
  silent
  printf "AES ownership cache-check result: status=0x%x, isProvisioned=%u\n", $eax, *(unsigned int *) ($rsp + 0x6c)
  if $eax != 0 || *(unsigned int *) ($rsp + 0x6c) != 1
    printf "AES ownership guard: cache correction did not hold; aborting.\n"
    kill
    quit 4
  end
  set $vfs495_setowner_result_ptr = $rsp + 0x50
  continue
end

break *0x44ba92
commands 7
  silent
  printf "AES ownership async submission result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *0x441f70
commands 8
  silent
  if $vfs495_setowner_result_ptr != 0 && $rdx == $vfs495_setowner_result_ptr
    printf "AES ownership async callback result: 0x%x (%d): %s\n", $esi, $esi, (char *) SensorResultStatus((int) $esi)
  end
  continue
end

break *0x44baae
commands 9
  silent
  printf "AES ownership async wait result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *0x44bab5
commands 10
  silent
  printf "AES ownership stored callback result: 0x%x (%d)\n", *(unsigned int *) $vfs495_setowner_result_ptr, *(unsigned int *) $vfs495_setowner_result_ptr
  continue
end

break *SensorSetOwnerWithKeys+0x74a
commands 11
  silent
  printf "vcsSensorSetOwnerWithKeys result: 0x%x (%d): %s\n", $eax, $eax, (char *) SensorResultStatus((int) $eax)
  continue
end

run
