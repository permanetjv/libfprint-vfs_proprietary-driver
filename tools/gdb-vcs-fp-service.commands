set pagination off
set startup-with-shell off
set debuginfod enabled off
set confirm off
set follow-fork-mode parent
set detach-on-fork on

# vcsFPService is stripped, but its service entry points remain in the dynamic
# symbol table.  Stop at the ELF entry point before installing breakpoints.
starti

# The service runs shell cleanup through vfork before it daemonizes with fork.
# Stay with the parent for the former, then follow the actual daemon child.
catch fork
commands
  silent
  set follow-fork-mode child
  continue
end

break serviceVcsSensorGetFingerprintAsync
commands
  silent
  printf "serviceVcsSensorGetFingerprintAsync request\n"
  continue
end

break *serviceVcsSensorGetFingerprintAsync+0x63
commands
  silent
  printf "  vcsFPAddToCallbackList result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *serviceVcsSensorGetFingerprintAsync+0xfe
commands
  silent
  printf "  sensor lookup result: %p\n", $rax
  continue
end

break *serviceVcsSensorGetFingerprintAsync+0x119
commands
  silent
  printf "  sensor state query result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *serviceVcsSensorGetFingerprintAsync+0x13a
commands
  silent
  printf "  vcsSensorUpdateGetPrintContext result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *serviceVcsSensorGetFingerprintAsync+0x217
commands
  silent
  printf "  prepare-get-print method result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *serviceVcsSensorGetFingerprintAsync+0x232
commands
  silent
  printf "  vcsFPServiceStartGetPrintThread result: 0x%x (%d)\n", $eax, $eax
  continue
end

break _vcsSensorPrepareGetFingerprintContext
commands
  silent
  printf "  preparing fingerprint context with path: %s\n", (char *)$rsi
  continue
end

break *_vcsSensorPrepareGetFingerprintContext+0x4e
commands
  silent
  printf "    vcsSensorValidate result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *_vcsSensorPrepareGetFingerprintContext+0x6a
commands
  silent
  printf "    reconstructed-image size result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *_vcsSensorPrepareGetFingerprintContext+0xb0
commands
  silent
  printf "    image allocation result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *_vcsSensorPrepareGetFingerprintContext+0xdc
commands
  silent
  printf "    capture-metrics result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *_vcsSensorPrepareGetFingerprintContext+0xfc
commands
  silent
  printf "    capture-mode result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *_vcsSensorPrepareGetFingerprintContext+0x112
commands
  silent
  printf "    sensor-context allocation result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *_vcsSensorPrepareGetFingerprintContext+0x128
commands
  silent
  printf "    sensor-handle context result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *_vcsSensorPrepareGetFingerprintContext+0x13f
commands
  silent
  printf "    file-path context result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *_vcsSensorPrepareGetFingerprintContext+0x15b
commands
  silent
  printf "    capture-parameter context result: 0x%x (%d)\n", $eax, $eax
  continue
end

break *vcsFPGetFingerprintIncludeESD+0xe8
commands
  silent
  printf "  worker vcsSensorGetFingerprintAsyncA result: 0x%x (%d)\n", $eax, $eax
  continue
end

continue
